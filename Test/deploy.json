{
  "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "AzureUserName": {
      "type": "string"
    },
    "AzurePassword": {
      "type": "securestring"
    },
    "ODLID": {
      "type": "string"
    },
    "DeploymentID": {
      "type": "string"
    },
    "adminUsername": {
      "type": "string"
    },
    "adminPassword": {
      "type": "securestring"
    },
    "trainerUserName": {
      "type": "string"
    },
    "trainerUserPassword": {
      "type": "string"
    },
    "InstallCloudLabsShadow": {
      "type": "string",
      "defaultValue": "yes",
      "allowedValues": [
        "yes",
        "no"
      ]
    },
    "sku": {
      "type": "string",
      "allowedValues": [
        "F2"
      ]
    },
    "emailId": {
      "type": "string",
      "defaultValue": " "
    },
    "PAT": {
      "type": "string"
    },
    "GitHubOrg": {
      "type": "string"
    },
    "GitHubUserName": {
      "type": "string"
    },
    "foundryModelCapacity": {
      "type": "int",
      "defaultValue": 10
    },
    "embeddingModelCapacity": {
      "type": "int",
      "defaultValue": 10
    },
    "AppId": {
      "type": "String"
    },
    "AppSecret": {
      "type": "string"
    },
    "azuserobjectid": {
      "type": "string"
    },
    "sqlAdminUsername": {
      "type": "string",
      "defaultValue": "sqladmin",
      "minLength": 4,
      "maxLength": 32,
      "metadata": {
        "description": "SQL authentication administrator login. Cannot be 'admin', 'administrator', 'sa', 'root', 'dbmanager', 'loginmanager', 'guest' or 'public'."
      }
    },
    "sqlAdminPassword": {
      "type": "securestring",
      "minLength": 12,
      "metadata": {
        "description": "SQL authentication administrator password. Must meet SQL complexity rules. Avoid double-quote, dollar-sign, percent, caret, ampersand and backtick characters - the value crosses the CustomScriptExtension command line and those characters break argument parsing."
      }
    }
  },
  "variables": {
    "cloudlabsCommon": "[concat(' -AzureUserName ', parameters('AzureUserName'), ' -InstallCloudLabsShadow ', parameters('InstallCloudLabsShadow'), ' -AzurePassword ', parameters('AzurePassword'), ' -AzureTenantID ', variables('AzureTenantID'), ' -AzureSubscriptionID ', variables('AzureSubscriptionID'), ' -ODLID ', parameters('ODLID'), ' -DeploymentID ', parameters('DeploymentID'), ' -adminPassword ', parameters('adminPassword'), ' -GitHubUserName ', variables('transformedValue'), ' -PAT ', parameters('PAT'), ' -GitHubOrg ', parameters('GitHubOrg'), ' -ghsecret ', variables('ghsecret'), ' -azuserobjectid ', parameters('azuserobjectid'), ' -AppId ', parameters('AppId'), ' -AppSecret ', parameters('AppSecret'))]",
    "Enable-CloudLabsEmbeddedShadow": "[concat(' -vmAdminUsername ', parameters('adminUsername'), ' -trainerUserName ', parameters('trainerUserName'), ' -trainerUserPassword ', parameters('trainerUserPassword'))]",
    "AzureTenantID": "[subscription().tenantId]",
    "AzureSubscriptionID": "[subscription().subscriptionId]",
    "location": "[resourceGroup().location]",
    "fabriccapacityname": "[concat('capacity',parameters('DeploymentID'))]",
    "rgName": "[resourceGroup().name]",
    "LabVMName": "[concat('labvm-',parameters('DeploymentID'))]",
    "networkInterfaceName": "[concat(variables('LabVMName'), '-nic')]",
    "publicIpAddressName": "[concat(variables('LabVMName'), '-pip')]",
    "publicIpAddressDNSName": "[concat('lab',parameters('DeploymentID'), 'vm', uniqueString(resourceGroup().id))]",
    "networkSecurityGroupName": "[concat(variables('LabVMName'), '-nsg')]",
    "virtualNetworkName": "[concat(variables('LabVMName'), '-vnet')]",
    "vnetID": "[resourceId('Microsoft.Network/virtualNetworks',variables('virtualNetworkName'))]",
    "subnetRef": "[concat(variables('vnetID'),'/subnets/','subnet')]",
    "originalEmail": "[parameters('AzureUserName')]",
    "ghsecret": "w2R8Q~MooRgSA855CVxZitnxayzHDecQx4yFHahc",
    "extractedPart": "[split(variables('originalEmail'), '@')[0]]",
    "transformedValue": "[concat(replace(variables('extractedPart'), '_', '-'), '_clabs')]",
    "foundryAccountName": "[concat('foundry-', parameters('DeploymentID'))]",
    "foundryProjectName": "FAQ-Assistant-project",
    "foundryDeploymentName": "gpt-5.4",
    "embeddingDeploymentName": "text-embedding-3-small",
    "sqlServerName": "[concat('faq-ai-assistant-', parameters('DeploymentID'))]",
    "sqlDatabaseName": "[concat('faq-ai-assistant-db-', parameters('DeploymentID'))]",
    "sqlAdminIdentityName": "[concat('sql-admin-id-', parameters('DeploymentID'))]"
  },
  "resources": [
    {
      "name": "[variables('LabVMName')]",
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2022-11-01",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]"
      ],
      "plan": {
        "name": "win2022",
        "publisher": "spektra",
        "product": "cloudlabs-windows-jumpvm"
      },
      "properties": {
        "osProfile": {
          "computerName": "[variables('LabVMName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPassword')]",
          "windowsConfiguration": {
            "provisionVmAgent": "true"
          }
        },
        "hardwareProfile": {
          "vmSize": "Standard_D2s_v5"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Spektra",
            "offer": "cloudlabs-windows-jumpvm",
            "sku": "win2022",
            "version": "latest"
          },
          "osDisk": {
            "Name": "[concat(variables('LabVMName'),'-osdisk')]",
            "createOption": "fromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          },
          "dataDisks": []
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('networkInterfaceName'))]"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines/extensions",
      "name": "[concat(variables('LabVMName'),'/', 'winExtension')]",
      "apiVersion": "2024-11-01",
      "location": "[resourceGroup().location]",
      "comments": "Script",
      "tags": {
        "displayName": "VM Extension"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachines', variables('LabVMName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
        "[resourceId('Microsoft.Sql/servers/databases', variables('sqlServerName'), variables('sqlDatabaseName'))]",
        "[resourceId('Microsoft.Sql/servers/firewallRules', variables('sqlServerName'), 'AllowAzureServices')]",
        "[resourceId('Microsoft.Sql/servers/firewallRules', variables('sqlServerName'), 'AllowAll')]",
        "[resourceId('Microsoft.Resources/deployments', 'foundryProjectAndDeployments')]",
        "[resourceId('Microsoft.Fabric/capacities', variables('fabriccapacityname'))]"
      ],
      "properties": {
        "publisher": "Microsoft.Compute",
        "type": "CustomScriptExtension",
        "typeHandlerVersion": "1.8",
        "autoUpgradeMinorVersion": true,
        "settings": {
          "fileUris": [
            "https://experienceazure.blob.core.windows.net/templates/cloudlabs-common/cloudlabs-windows-functions.ps1",
            "https://openai123241.blob.core.windows.net/teststorage2327061/psscript-03.ps1"
          ]
        },
        "protectedSettings": {
          "commandToExecute": "[concat('powershell.exe -ExecutionPolicy Unrestricted -File psscript-03.ps1', variables('cloudlabsCommon'), variables('Enable-CloudLabsEmbeddedShadow'), ' -ResourceGroupName ', variables('rgName'), ' -SqlServerFqdn ', reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName'))).fullyQualifiedDomainName, ' -SqlDatabaseName ', variables('sqlDatabaseName'), ' -SqlAdminUsername ', parameters('sqlAdminUsername'), ' -SqlAdminPassword \"', parameters('sqlAdminPassword'), '\" -FoundryAccountName ', variables('foundryAccountName'), ' -FoundryEndpoint ', reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))).endpoint, ' -EmbeddingDeploymentName ', variables('embeddingDeploymentName'), ' -ChatDeploymentName ', variables('foundryDeploymentName'))]"
        }
      }
    },
    {
      "name": "[variables('virtualNetworkName')]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2022-09-01",
      "location": "[resourceGroup().location]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "subnet",
            "properties": {
              "addressPrefix": "10.0.0.0/24"
            }
          }
        ]
      }
    },
    {
      "name": "[variables('networkInterfaceName')]",
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2022-09-01",
      "location": "[resourceGroup().location]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('virtualNetworkName'))]",
        "[resourceId('Microsoft.Network/publicIpAddresses', variables('publicIpAddressName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[variables('subnetRef')]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIpAddress": {
                "id": "[resourceId('Microsoft.Network/publicIpAddresses', variables('publicIpAddressName'))]"
              }
            }
          }
        ],
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('networkSecurityGroupName'))]"
        }
      }
    },
    {
      "name": "[variables('publicIpAddressName')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2022-09-01",
      "comments": "Public IP",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "Standard"
      },
      "tags": {
        "displayName": "Public IP"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[variables('publicIpAddressDNSName')]"
        }
      }
    },
    {
      "name": "[variables('networkSecurityGroupName')]",
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2022-09-01",
      "location": "[resourceGroup().location]",
      "properties": {
        "securityRules": [
          {
            "name": "default-allow-rdp",
            "properties": {
              "priority": 1000,
              "protocol": "TCP",
              "access": "Allow",
              "direction": "Inbound",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "3389"
            }
          }
        ]
      }
    },
    {
      "apiVersion": "2023-11-01",
      "type": "Microsoft.Fabric/capacities",
      "name": "[variables('fabriccapacityname')]",
      "location": "[variables('location')]",
      "sku": {
        "name": "[parameters('sku')]",
        "tier": "Fabric"
      },
      "properties": {
        "administration": {
          "members": [
            "[parameters('AzureUserName')]"
          ]
        }
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[variables('foundryAccountName')]",
      "location": "[variables('location')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "customSubDomainName": "[variables('foundryAccountName')]",
        "publicNetworkAccess": "Enabled",
        "allowProjectManagement": true
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "foundryProjectAndDeployments",
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "resources": [
            {
              "type": "Microsoft.CognitiveServices/accounts/projects",
              "apiVersion": "2025-06-01",
              "name": "[concat(variables('foundryAccountName'), '/', variables('foundryProjectName'))]",
              "location": "[variables('location')]",
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {}
            },
            {
              "type": "Microsoft.CognitiveServices/accounts/deployments",
              "apiVersion": "2025-06-01",
              "name": "[concat(variables('foundryAccountName'), '/', variables('foundryDeploymentName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.CognitiveServices/accounts/projects', variables('foundryAccountName'), variables('foundryProjectName'))]"
              ],
              "sku": {
                "name": "GlobalStandard",
                "capacity": "[parameters('foundryModelCapacity')]"
              },
              "properties": {
                "model": {
                  "format": "OpenAI",
                  "name": "gpt-5.4",
                  "version": "2026-03-05"
                },
                "raiPolicyName": "Microsoft.Default"
              }
            },
            {
              "type": "Microsoft.CognitiveServices/accounts/deployments",
              "apiVersion": "2025-06-01",
              "name": "[concat(variables('foundryAccountName'), '/', variables('embeddingDeploymentName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('foundryAccountName'), variables('foundryDeploymentName'))]"
              ],
              "sku": {
                "name": "GlobalStandard",
                "capacity": "[parameters('embeddingModelCapacity')]"
              },
              "properties": {
                "model": {
                  "format": "OpenAI",
                  "name": "text-embedding-3-small",
                  "version": "1"
                },
                "raiPolicyName": "Microsoft.Default"
              }
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('sqlAdminIdentityName')]",
      "location": "[variables('location')]"
    },
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2025-01-01",
      "name": "[variables('sqlServerName')]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('sqlAdminIdentityName'))]"
      ],
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('sqlAdminIdentityName'))]": {}
        }
      },
      "properties": {
        "version": "12.0",
        "publicNetworkAccess": "Enabled",
        "minimalTlsVersion": "1.2",
        "administratorLogin": "[parameters('sqlAdminUsername')]",
        "administratorLoginPassword": "[parameters('sqlAdminPassword')]",
        "primaryUserAssignedIdentityId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('sqlAdminIdentityName'))]",
        "administrators": {
          "administratorType": "ActiveDirectory",
          "principalType": "User",
          "login": "[parameters('AzureUserName')]",
          "sid": "[parameters('azuserobjectid')]",
          "tenantId": "[subscription().tenantId]",
          "azureADOnlyAuthentication": false
        }
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2025-01-01",
      "name": "[concat(variables('sqlServerName'), '/AllowAzureServices')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2025-01-01",
      "name": "[concat(variables('sqlServerName'), '/AllowAll')]",
      "comments": "Lab-only rule so participants can reach the database from the lab VM public IP and from VS Code / SSMS on their own machine. Remove for any non-lab deployment.",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
        "[resourceId('Microsoft.Sql/servers/firewallRules', variables('sqlServerName'), 'AllowAzureServices')]"
      ],
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "255.255.255.255"
      }
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2025-01-01",
      "name": "[concat(variables('sqlServerName'), '/', variables('sqlDatabaseName'))]",
      "location": "[variables('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ],
      "sku": {
        "name": "HS_Gen5_2",
        "tier": "Hyperscale",
        "family": "Gen5",
        "capacity": 2
      },
      "properties": {
        "zoneRedundant": false
      }
    }
  ],
  "outputs": {
    "DeploymentID": {
      "type": "string",
      "value": "[parameters('DeploymentID')]"
    },
    "LabVM Admin Username": {
      "type": "string",
      "value": "[parameters('adminUsername')]"
    },
    "LabVM Admin Password": {
      "type": "string",
      "value": "[parameters('adminPassword')]"
    },
    "LabVM DNS Name": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses',variables('publicIpAddressName'))).dnsSettings.fqdn]"
    },
    "Trainer UserName": {
      "type": "string",
      "value": "[parameters('trainerUserName')]"
    },
    "Trainer Password": {
      "type": "String",
      "value": "[parameters('trainerUserPassword')]"
    },
    "GitHub User Name": {
      "type": "string",
      "value": "[variables('transformedValue')]"
    },
    "Region": {
      "type": "string",
      "value": "[variables('location')]"
    },
    "GitHub Password": {
      "type": "String",
      "value": "[parameters('azurePassword')]"
    },
    "GitHub Signup": {
      "type": "String",
      "value": "https://myapplications.microsoft.com/?tenantid=f871d17e-efcd-44c7-ba5a-0162efa2fded"
    },
    "SQL Server Name": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName'))).fullyQualifiedDomainName]"
    },
    "SQL Database Name": {
      "type": "string",
      "value": "[variables('sqlDatabaseName')]"
    },
    "SQL Admin Username": {
      "type": "string",
      "value": "[parameters('sqlAdminUsername')]"
    },
    "SQL Admin Password": {
      "type": "string",
      "value": "[parameters('sqlAdminPassword')]"
    },
    "SQL Entra Admin": {
      "type": "string",
      "value": "[parameters('AzureUserName')]"
    },
    "Foundry Account Name": {
      "type": "string",
      "value": "[variables('foundryAccountName')]"
    },
    "Foundry Endpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))).endpoint]"
    }
  }
}
